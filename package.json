{
  "name": "agent-suite-estimator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "format": "prettier --write src e2e vite.config.ts playwright.config.ts && .venv/bin/ruff format backend",
    "check": "tsc -b && prettier --check src e2e vite.config.ts playwright.config.ts && .venv/bin/ruff check backend",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": ".venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "exceljs": "^4.4.0",
    "hyperformula": "^3.1.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.0",
    "vite": "^6.4.0"
  }
}
